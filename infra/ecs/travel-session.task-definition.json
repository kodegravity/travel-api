{
  "family": "ai-travel-companion-travel-session",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ai-travel-companion-ecs-execution",
  "containerDefinitions": [
    {
      "name": "ai-travel-companion-travel-session",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-2.amazonaws.com/ai-travel-companion-travel-session:<IMAGE_TAG>",
      "essential": true,
      "user": "10001:10001",
      "portMappings": [
        {
          "name": "http",
          "containerPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "RECOMMENDATION_SERVICE_BASE_URL",
          "value": "http://recommendation:8081"
        },
        {
          "name": "CORS_ALLOWED_ORIGINS",
          "value": "<FRONTEND_ORIGIN>"
        },
        {
          "name": "OKTA_ISSUER",
          "value": "<OKTA_ISSUER>"
        },
        {
          "name": "OKTA_AUDIENCE",
          "value": "<OKTA_AUDIENCE>"
        },
        {
          "name": "LOGGING_STRUCTURED_FORMAT_CONSOLE",
          "value": "ecs"
        },
        {
          "name": "LOGGING_LEVEL_COM_AITRAVEL",
          "value": "INFO"
        }
      ],
      "secrets": [],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -q -O /dev/null http://127.0.0.1:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "stopTimeout": 30,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-travel-companion-travel-session",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
